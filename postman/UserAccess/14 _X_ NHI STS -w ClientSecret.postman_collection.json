  "item": [
    {
      "name": "01 Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"_sts-nhi-cid-secret-subject-token\", pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "scope",
              "value": "{{nhi-scope}}"
            },
            {
              "key": "resource",
              "value": "{{nhi-client-id-secret-resource}}"
            },
            {
              "key": "client_id",
              "value": "{{nhi-client_id}}"
            },
            {
              "key": "client_secret",
              "value": "{{nhi-client_secret}}"
            }
          ]
        },
        "url": {
          "raw": "{{url}}/oauth2/{{agent-authZ-server-ID}}/v1/token",
          "host": [
            "{{url}}"
          ],
          "path": [
            "oauth2",
            "{{agent-authZ-server-ID}}",
            "v1",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 Get STS Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:token-exchange"
            },
            {
              "key": "requested_token_type",
              "value": "urn:okta:params:oauth:token-type:oauth-sts"
            },
            {
              "key": "subject_token",
              "value": "{{_sts-nhi-cid-secret-subject-token}}"
            },
            {
              "key": "subject_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token"
            },
            {
              "key": "resource",
              "value": "{{sts-secret-orn}}"
            },
            {
              "key": "client_id",
              "value": "{{agent-secret-client_id}}"
            },
            {
              "key": "client_secret",
              "value": "{{agent-secret-client_secret}}"
            }
          ]
        },
        "url": {
          "raw": "{{url}}/oauth2/v1/token",
          "host": [
            "{{url}}"
          ],
          "path": [
            "oauth2",
            "v1",
            "token"
          ]
        }
      },
      "response": []
    }
  ]
